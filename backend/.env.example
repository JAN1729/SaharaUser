# Export these as server environment variables. This file is not loaded automatically.
SAHARA_DATABASE=data/sahara.sqlite3
# Required to enter live mode. Do not embed production provider keys in Android.
SAHARA_API_KEY=
SAHARA_SCRAPING_ENABLED=true
# auto selects installed Scrapling HTTP sessions, otherwise httpx. Browser DOM remains Playwright.
SAHARA_HTTP_ENGINE=auto
# Regular browser rendering only; no access-challenge bypass.
SAHARA_BROWSER_ENABLED=true
# Optional: installed Chrome executable path, or install Playwright Chromium.
SAHARA_BROWSER_EXECUTABLE=
# Optional language interpreter only. Never used as a transport inventory source.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Structured decisions through the same protected OpenRouter key; no separate TypeSafe key.
SAHARA_JEV_ENABLED=true
SAHARA_JEV_MODEL=typesafe/jev-1.13
# Keep semantic-only matches in review until calibrated with independently labeled transport data.
SAHARA_JEV_ACCEPT_MATCHES=false
# Optional trusted notice metadata origins: source@hostname;source2@hostname2. Empty keeps notices in review.
SAHARA_NOTICE_SOURCES=
# Optional server-owned path to normalized JSON: {"legs": [Leg objects]}.
SAHARA_LOCAL_FEED=
# Optional existing driver project; read-only registered fleet telemetry.
SAHARA_DRIVER_URL=
SAHARA_DRIVER_READ_KEY=
# Optional server-owned route geometry graph, with source provenance; never model-generated lines.
SAHARA_ROUTE_GRAPH=
