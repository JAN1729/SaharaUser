# ===========================================
# ANDROID GITIGNORE - SECURITY FOCUSED
# ===========================================

# Gradle
.gradle/
build/
/captures

# IDE
/.idea
*.iml
.DS_Store
*.hprof

# External Native Builds
.externalNativeBuild
.cxx

# ===========================================
# SECURITY - NEVER COMMIT THESE FILES
# ===========================================

# API Keys and Secrets

local.properties

*.env
.env
.env.local
.env.*
secrets.properties
api-keys.properties

# Keystore files (signing keys)
*.jks
*.keystore
keystore.properties

# Service account files
*.json
!package.json
google-services.json

# ===========================================
# BUILD ARTIFACTS
# ===========================================

# APK and Bundle outputs (contain embedded keys)
*.apk
*.aab
*.ap_

# Debug files
*.dex
*.class

# Log files
*.log

# Temporary files
*.tmp
*.temp
*.bak

# Independent reference checkout and local Python runtime data
/references/
/backend/data/
/data/
/builds/
/backend/build/
/backend/*.egg-info/
/visaguy_mcp/build/
/visaguy_mcp/dist/
/visaguy_mcp/*.egg-info/
dist/
build/
*.egg-info/
*.egg
!/backend/.env.example
!/backend/tests/fixtures/*.json
/backend/.venv/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Local screenshot dumps
screen.png
